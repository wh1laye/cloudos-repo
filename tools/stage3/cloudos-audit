#!/bin/bash
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
R=${CLOUDOS_ROOT:-}
ok=0; bad=0; warn=0
CIS=0
case "${1:-}" in --cis) CIS=1 ;; "") ;; *) echo "cloudos-audit [--cis]" >&2; exit 2 ;; esac

good() { printf '[ ok ] %s\n' "$*"; ok=$((ok + 1)); }
fail() { printf '[ !! ] %s\n' "$*"; bad=$((bad + 1)); }
note() { printf '[ .. ] %s\n' "$*"; warn=$((warn + 1)); }

[ -n "$R" ] || [ "$(id -u)" = 0 ] || { echo "нужен root" >&2; exit 2; }

echo "== фаервол"
if command -v nft >/dev/null && nft list chain inet cloudos input 2>/dev/null | grep -q 'policy drop'; then
  good "nftables загружен, input drop"
else
  fail "нет правил nftables с policy drop (cloudos-firewall on)"
fi

echo "== ядро"
if [ -z "$R" ]; then
  chk() {
    local v
    v=$(sysctl -n "$1" 2>/dev/null) || { note "нет параметра $1"; return; }
    [ "$v" = "$2" ] && good "$1 = $2" || fail "$1 = $v, нужно $2"
  }
  chk kernel.kptr_restrict 2
  chk kernel.dmesg_restrict 1
  chk kernel.randomize_va_space 2
  chk kernel.yama.ptrace_scope 2
  chk vm.mmap_min_addr 65536
  chk kernel.unprivileged_bpf_disabled 1
  chk fs.protected_symlinks 1
  chk fs.protected_hardlinks 1
  chk fs.suid_dumpable 0
  chk net.ipv4.tcp_syncookies 1
  chk net.ipv4.conf.all.rp_filter 1
  chk net.ipv4.conf.all.accept_redirects 0
  chk net.ipv4.conf.all.accept_source_route 0
  for o in slab_nomerge init_on_alloc=1 randomize_kstack_offset=on; do
    grep -qw -- "$o" /proc/cmdline && good "cmdline: $o" || note "в cmdline нет $o"
  done
fi

echo "== учётные записи"
SH=$R/etc/shadow
if [ -r "$SH" ]; then
  e=$(awk -F: '$2 == "" { print $1 }' "$SH" | tr '\n' ' ')
  [ -z "$e" ] && good "нет учёток с пустым паролем" || fail "пустой пароль: $e"
  m=$(stat -c %a "$SH")
  case $m in 600|640|400|000) good "/etc/shadow права $m" ;; *) fail "/etc/shadow права $m" ;; esac
fi
u=$(awk -F: '$3 == 0 && $1 != "root" { print $1 }' "$R/etc/passwd" | tr '\n' ' ')
[ -z "$u" ] && good "uid 0 только у root" || fail "лишний uid 0: $u"

echo "== вход и ssh"
SC=$R/etc/ssh/sshd_config.d/10-cloudos.conf
if [ -e "$SC" ]; then
  grep -q '^PasswordAuthentication no' "$SC" && good "ssh: вход по паролю закрыт" || fail "ssh: вход по паролю не закрыт"
  grep -q '^AuthenticationMethods publickey' "$SC" && good "ssh: только ключи" || fail "ssh: не только ключи"
  grep -q '^DisableForwarding yes' "$SC" && good "ssh: проброс закрыт" || fail "ssh: проброс не закрыт"
else
  note "нет $SC"
fi
if [ -r "$R/etc/shadow" ]; then
  r=$(awk -F: '$1 == "root" { print $2 }' "$R/etc/shadow")
  case $r in '!'*|'*'*|'') good "root без пароля для входа (заблокирован)" ;; *) note "у root задан пароль" ;; esac
fi
grep -qs 'pam_faillock.so' "$R/etc/pam.d/system-auth" && good "pam: блокировка после 5 неудачных входов" || note "pam_faillock не включён"
[ -e "$R/etc/modprobe.d/cloudos.conf" ] && good "modprobe: редкие протоколы и fs отключены" || note "нет /etc/modprobe.d/cloudos.conf"
[ "$(stat -c %a "$R/root" 2>/dev/null)" = 700 ] && good "/root права 700" || fail "/root права не 700"

echo "== файлы"
w=$(find "$R/etc" -xdev -type f -perm -0002 2>/dev/null | head -n 10)
[ -z "$w" ] && good "в /etc нет файлов с записью для всех" || fail "запись для всех: $(echo $w)"
s=$(find "$R/usr" "$R/bin" "$R/sbin" -xdev -type f -perm -4000 2>/dev/null | sed "s|^$R||" | sort | tr '\n' ' ')
echo "[ .. ] setuid: $s"
x=$(find "$R/usr" "$R/bin" "$R/sbin" -xdev -type f -perm -4000 2>/dev/null | sed "s|^$R||" | grep -vE '/(su|passwd|chsh|chfn|newgrp|doas|unix_chkpwd|mount|umount|gpasswd|expiry|chage)$' | head -n 10)
[ -z "$x" ] && good "setuid только из ожидаемого набора" || note "неожиданные setuid: $(echo $x)"

echo "== сеть"
if [ -z "$R" ] && command -v ss >/dev/null; then
  l=$(ss -H -tulpn 2>/dev/null | awk '$5 !~ /^(127\.|\[::1\]|::1)/ { print $1, $5, $7 }')
  if [ -z "$l" ]; then good "нет сокетов, слушающих снаружи"; else note "слушают снаружи:"; printf '%s\n' "$l" | sed 's/^/       /'; fi
fi
if [ -z "$R" ] && command -v sshd >/dev/null && rc-service sshd status >/dev/null 2>&1; then
  c=$(sshd -T 2>/dev/null)
  printf '%s\n' "$c" | grep -qi '^permitrootlogin no' && good "sshd: root закрыт" || fail "sshd: root-вход не закрыт"
  printf '%s\n' "$c" | grep -qi '^permitemptypasswords no' && good "sshd: пустые пароли запрещены" || fail "sshd: пустые пароли разрешены"
fi

echo "== загрузка и диск"
if [ -z "$R" ]; then
  gv=8be4df61-93ca-11d2-aa0d-00e098032b8c
  if [ -r /sys/firmware/efi/efivars/SecureBoot-$gv ]; then
    [ "$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-$gv | awk '{ print $NF }')" = 1 ] && good "secure boot включён" || note "secure boot выключен (cloudos-secureboot)"
  else
    note "загрузка не через uefi, secure boot недоступен"
  fi
  grep -q '\[\(integrity\|confidentiality\)\]' /sys/kernel/security/lockdown 2>/dev/null && good "kernel lockdown включён" || note "kernel lockdown выключен"
  if [ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y ]; then
    good "apparmor включён"
    n=$(aa-status --enforced 2>/dev/null || echo 0)
    [ "${n:-0}" -gt 0 ] 2>/dev/null && good "apparmor: профилей в enforce: $n" || note "apparmor: нет профилей в enforce (aa-enforce /etc/apparmor.d/...)"
  else
    note "apparmor выключен в ядре"
  fi
  [ "$(cat /sys/module/module/parameters/sig_enforce 2>/dev/null)" = Y ] && good "модули ядра только с подписью" || fail "подпись модулей не обязательна"
  rs=$(findmnt -no SOURCE / 2>/dev/null || true)
  if [ -n "$rs" ] && lsblk -srno TYPE "$rs" 2>/dev/null | grep -q crypt; then good "корень на luks"; else note "корень не зашифрован (luks)"; fi
  [ "$(cat /sys/devices/system/cpu/smt/control 2>/dev/null)" = on ] && note "smt включён (профиль secure его отключает)" || true
  for v in /sys/devices/system/cpu/vulnerabilities/*; do
    [ -r "$v" ] || continue
    if grep -q '^Vulnerable' "$v"; then note "cpu $(basename "$v"): $(cat "$v")"; fi
  done
fi

if [ "$CIS" = 1 ]; then
  echo "== профиль cis (по мотивам cis benchmark для linux, не сертификация)"
  mode() { stat -c '%a' "$1" 2>/dev/null || echo -; }
  perm() {
    local m; m=$(mode "$R$1")
    [ "$m" = - ] && { note "нет файла $1"; return; }
    [ "$((8#$m & 8#$3))" = 0 ] && good "$1: права $m" || fail "$1: права $m, лишнее для $2"
  }
  perm /etc/passwd "группы и остальных на запись" 022
  perm /etc/group "группы и остальных на запись" 022
  perm /etc/shadow "группы на запись и остальных" 037
  perm /etc/gshadow "группы на запись и остальных" 037
  perm /etc/ssh/sshd_config "группы и остальных на запись" 022
  if [ -r "$R/etc/shadow" ]; then
    [ -z "$(awk -F: '$2 == "" { print $1 }' "$R/etc/shadow")" ] && good "нет учётных записей с пустым паролем" || fail "есть учётные записи с пустым паролем"
  fi
  [ "$(awk -F: '$3 == 0 { print $1 }' "$R/etc/passwd" | tr '\n' ' ')" = "root " ] && good "uid 0 только у root" || fail "uid 0 не только у root"
  md=$(awk '$1 == "PASS_MAX_DAYS" { print $2 }' "$R/etc/login.defs" 2>/dev/null | tail -1)
  { [ -n "${md:-}" ] && [ "$md" -le 365 ] 2>/dev/null; } && good "PASS_MAX_DAYS = $md" || note "PASS_MAX_DAYS не задан или больше 365"
  um=$(awk '$1 == "UMASK" { print $2 }' "$R/etc/login.defs" 2>/dev/null | tail -1)
  case "${um:-}" in 027|077) good "UMASK = $um" ;; *) note "UMASK ${um:-не задан}, нужно 027 или строже" ;; esac
  for fsn in cramfs freevxfs jffs2 hfs hfsplus udf; do
    grep -rqs "^install $fsn /bin/\(true\|false\)\|^blacklist $fsn" "$R/etc/modprobe.d" && good "файловая система $fsn отключена" || note "файловая система $fsn не отключена в modprobe.d"
  done
  grep -qsE '^\*[[:space:]]+hard[[:space:]]+core[[:space:]]+0' "$R/etc/security/limits.conf" "$R"/etc/security/limits.d/* && good "core-дампы запрещены" || note "core-дампы не запрещены в limits"
  [ -s "$R/etc/issue" ] && good "есть /etc/issue" || note "пустой /etc/issue (баннер)"
  if [ -z "$R" ]; then
    chk net.ipv4.ip_forward 0
    chk net.ipv4.conf.all.send_redirects 0
    chk net.ipv4.conf.all.log_martians 1
    chk net.ipv4.icmp_echo_ignore_broadcasts 1
    chk net.ipv4.conf.all.secure_redirects 0
    chk net.ipv6.conf.all.accept_ra 0
    ww=$(find / -xdev -type d -perm -0002 ! -perm -1000 2>/dev/null | head -3)
    [ -z "$ww" ] && good "нет каталогов с записью для всех без sticky" || fail "каталоги с записью для всех без sticky: $(echo "$ww" | tr '\n' ' ')"
    nu=$(find / -xdev \( -nouser -o -nogroup \) 2>/dev/null | head -3)
    [ -z "$nu" ] && good "нет файлов без владельца" || note "файлы без владельца: $(echo "$nu" | tr '\n' ' ')"
    if command -v sshd >/dev/null; then
      c=$(sshd -T 2>/dev/null)
      printf '%s\n' "$c" | grep -qi '^x11forwarding no' && good "sshd: x11 выключен" || note "sshd: x11forwarding не no"
      mt=$(printf '%s\n' "$c" | awk 'tolower($1) == "maxauthtries" { print $2 }')
      [ -n "$mt" ] && [ "$mt" -le 4 ] && good "sshd: MaxAuthTries = $mt" || note "sshd: MaxAuthTries больше 4"
    fi
  fi
fi

echo
echo "итог: ok $ok, ошибок $bad, замечаний $warn"
awk -v o=$ok -v b=$bad -v w=$warn 'BEGIN { t = o + b * 2 + w * 0.5; printf "оценка: %d из 100\n", (t > 0 ? o * 100 / t : 0) }'
[ "$bad" = 0 ]
