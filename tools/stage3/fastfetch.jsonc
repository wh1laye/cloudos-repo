{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/cloudos/logo.txt",
    "color": { "1": "38;5;153", "2": "38;5;111", "3": "38;5;110", "4": "38;5;68", "5": "38;5;25" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;5;110", "title": "38;5;153", "separator": "38;5;67" }
  },
  "modules": [
    "title", "separator", "os", "host", "kernel",
    { "type": "initsystem", "key": "Init" },
    "uptime", "packages",
    { "type": "command", "key": "cloudpkg", "text": "cloudpkg version | cut -d' ' -f2" },
    "shell", "terminal", "cpu", "gpu", "memory", "swap", "disk", "localip", "locale",
    "break", "colors"
  ]
}
