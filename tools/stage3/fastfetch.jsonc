{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/cloudos/logo.txt",
    "color": { "1": "38;5;153", "2": "38;5;110", "3": "38;5;67" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;5;110", "title": "38;5;153", "separator": "38;5;67" }
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "terminal", "cpu", "gpu", "memory", "swap", "disk", "localip",
    "break", "colors"
  ]
}
