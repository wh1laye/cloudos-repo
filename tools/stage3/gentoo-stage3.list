# пакеты, которые есть в gentoo stage 3 (amd64, openrc), без их пакетного менеджера и их фишек
# (что исключено и почему: gentoo-exclude.txt). то, что уже собрано в базе cloudos или стоит в
# package.provided, при сборке пропускается само. список составлен вручную. чтобы взять точный
# список из настоящего stage 3 gentoo, запусти tools/stage3/refresh-list.sh (нужна сеть).
# по одному пакету в строке, # комментарий.

# архивы и сжатие
app-arch/bzip2
app-arch/cpio
app-arch/gzip
app-arch/libarchive
app-arch/tar
app-arch/unzip
app-arch/xz-utils
app-arch/zstd

# редакторы, оболочка, сертификаты, ключи
app-editors/nano
app-shells/bash
app-misc/ca-certificates
app-crypt/gnupg

# справка (в gentoo stage 3 есть man)
app-text/man-db
sys-apps/man-pages

# сборка и языки
