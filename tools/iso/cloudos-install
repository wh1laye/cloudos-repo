#!/bin/bash
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

T=${CLOUDOS_TARGET:-/mnt/cloudos}
SQ=${CLOUDOS_SQUASHFS:-/media/cdrom/cloudos/rootfs.squashfs}
BS=${CLOUDOS_BOOTSRC:-/media/cdrom/boot}
LS=/usr/share/limine
HARDEN='apparmor=1 security=apparmor slab_nomerge init_on_alloc=1 page_alloc.shuffle=1 randomize_kstack_offset=on vsyscall=none debugfs=off pti=on module.sig_enforce=1 efi=disable_early_pci_dma iommu.strict=1'
EXTRA=${CLOUDOS_CMDLINE_EXTRA:-}
MOUNTED=0
LUKSOPEN=0

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOU'
cloudos-install: install cloudos to disk

  cloudos-install                interactive
  cloudos-install --help         this help

modes:
  auto     the whole disk is wiped and partitioned automatically (boot + root)
  manual   you partition yourself (cfdisk, fdisk or sfdisk), then pick the root and boot
           partitions; only those two partitions are touched, the rest of the disk stays intact

variables for unattended install:
  CLOUDOS_MODE=auto|manual       install mode (manual if CLOUDOS_ROOT is set, auto if CLOUDOS_DISK is set)
  CLOUDOS_DISK=/dev/sda          auto mode: disk to wipe completely
  CLOUDOS_ROOT=/dev/sda3         manual mode: root partition, it will be formatted
  CLOUDOS_BOOT=/dev/sda1         manual mode: boot partition (efi system partition on uefi)
  CLOUDOS_FORMAT_BOOT=1|0        manual mode: format the boot partition (0 keeps an existing vfat and its files)
  CLOUDOS_FS=ext4|btrfs          root filesystem
  CLOUDOS_HOST=name              hostname
  CLOUDOS_USER=name              regular user (group wheel, doas)
  CLOUDOS_PASS=password          user password
  CLOUDOS_ROOTPASS=password      root password
  CLOUDOS_FW=uefi|bios           boot mode, detected automatically by default
  CLOUDOS_YES=1                  skip the erase confirmation
  CLOUDOS_LUKS=1                 encrypt root with luks2 (needs cryptsetup and dracut)
  CLOUDOS_LUKSPASS=password      disk encryption password
  CLOUDOS_PROFILE=balanced|secure|fast  secure: no smt, lockdown, init_on_free; fast: no watchdog and audit
  CLOUDOS_SECUREBOOT=1           own secure boot keys, signed limine, kernel hashes (uefi only)
  CLOUDOS_UKI=1                  signed unified kernel image as first entry (needs CLOUDOS_SECUREBOOT=1)
  CLOUDOS_KEYMAP=us|ru|name      keyboard: us (english only, default), ru (english + russian, english by default), or any kbd keymap
  CLOUDOS_SWITCH=alt_shift|ctrl_shift|caps  ru only: key combination that switches the layout (default alt_shift)
  CLOUDOS_LOCALE=en_US.UTF-8     system language (en_US.UTF-8, ru_RU.UTF-8, C.UTF-8)
  CLOUDOS_TZ=UTC                 time zone, for example Europe/Moscow
  CLOUDOS_CMDLINE_EXTRA="..."    extra kernel parameters
EOU
}

cleanup() {
  local rc=$?
  if [ "$MOUNTED" = 1 ]; then
    sync || true
    umount -R "$T" 2>/dev/null || { sleep 1; umount -R -l "$T" 2>/dev/null || true; }
  fi
  if [ "$LUKSOPEN" = 1 ]; then cryptsetup close cloudcrypt 2>/dev/null || true; fi
  exit "$rc"
}
trap cleanup EXIT

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

[ "$(id -u)" = 0 ] || die "root is required: doas cloudos-install"
[ "$(uname -m)" = x86_64 ] || die "x86_64 is required"
if [ "$(cat /etc/cloudos-march 2>/dev/null)" = x86-64-v3 ]; then
  for f in avx2 fma bmi1 bmi2 movbe f16c; do grep -qw "$f" /proc/cpuinfo || die "this iso is built for x86-64-v3, the cpu lacks $f"; done
fi
for c in sfdisk wipefs blkid lsblk findmnt mount umount unsquashfs mkfs.vfat mkfs.ext4 limine chroot install awk sed blockdev; do
  command -v "$c" >/dev/null || die "missing command $c"
done
[ -f "$SQ" ] || die "no $SQ, boot from the cloudos live iso"
[ -f "$BS/vmlinuz" ] || die "no $BS/vmlinuz"
for f in limine-bios.sys BOOTX64.EFI BOOTIA32.EFI; do [ -f "$LS/$f" ] || die "no $LS/$f"; done
if findmnt -rn "$T" >/dev/null 2>&1; then die "$T is already mounted"; fi

ask() {
  local var=$1 prompt=$2 def=${3:-} val
  if [ -n "${!var:-}" ]; then return 0; fi
  if [ -n "$def" ]; then read -r -p "$prompt [$def]: " val; val=${val:-$def}; else read -r -p "$prompt: " val; fi
  printf -v "$var" '%s' "$val"
}

askpass() {
  local var=$1 prompt=$2 a b
  if [ -n "${!var:-}" ]; then return 0; fi
  while :; do
    read -r -s -p "$prompt: " a; echo
    read -r -s -p "repeat password: " b; echo
    if [ -z "$a" ]; then echo "password cannot be empty"; continue; fi
    if [ "$a" != "$b" ]; then echo "passwords do not match"; continue; fi
    break
  done
  printf -v "$var" '%s' "$a"
}

askdef() {
  local var=$1
  if [ -z "${!var:-}" ] && [ "${CLOUDOS_YES:-0}" = 1 ]; then printf -v "$var" '%s' "$3"; return 0; fi
  ask "$@"
}

findmap() {
  find /usr/share/keymaps /usr/share/kbd/keymaps -name "$1.map*" -print -quit 2>/dev/null | grep -q .
}

findfont() {
  find /usr/share/consolefonts /usr/share/kbd/consolefonts -name "$1.*" -print -quit 2>/dev/null | grep -q .
}

FW=${CLOUDOS_FW:-}
if [ -z "$FW" ]; then if [ -d /sys/firmware/efi ]; then FW=uefi; else FW=bios; fi; fi
case $FW in uefi|bios) ;; *) die "CLOUDOS_FW must be uefi or bios" ;; esac
say "boot mode: $FW"

LIVEDISK=
src=$(findmnt -rn -o SOURCE /media/cdrom 2>/dev/null || true)
if [ -n "$src" ] && [ -b "$src" ]; then
  LIVEDISK=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1 || true)
  [ -n "$LIVEDISK" ] && LIVEDISK=/dev/$LIVEDISK
fi

showdisks() {
  lsblk -dpo NAME,SIZE,TYPE,TRAN,MODEL | awk 'NR == 1 || $3 == "disk"'
}

showparts() {
  lsblk -po NAME,SIZE,TYPE,FSTYPE,LABEL,PARTTYPENAME,MOUNTPOINT
}

sfdisk_script() {
  local d=$1 line s= c
  echo "enter sfdisk script lines, an empty line applies them. example for uefi:"
  echo "  label: gpt"
  echo "  ,512M,U"
  echo "  ,,L"
  while IFS= read -r -p "sfdisk> " line; do
    [ -n "$line" ] || break
    s="$s$line"$'\n'
  done
  [ -n "$s" ] || return 0
  echo "this rewrites the partition table of $d"
  read -r -p "type $d to confirm: " c
  [ "$c" = "$d" ] || { echo "cancelled"; return 0; }
  printf '%s' "$s" | sfdisk "$d" || echo "sfdisk failed"
}

partition_disks() {
  local d t
  while :; do
    echo "disks:"
    showdisks
    read -r -p "disk to partition (enter to continue): " d
    [ -n "$d" ] || return 0
    if [ ! -b "$d" ] || [ "$(lsblk -dno TYPE "$d")" != disk ]; then echo "$d is not a whole disk"; continue; fi
    if [ "$d" = "$LIVEDISK" ]; then echo "$d is the live iso medium"; continue; fi
    if lsblk -nrpo MOUNTPOINT "$d" | grep -q .; then echo "unmount the partitions of $d first"; continue; fi
    read -r -p "tool (cfdisk, fdisk, sfdisk) [cfdisk]: " t
    t=${t:-cfdisk}
    case $t in
      cfdisk|fdisk)
        if command -v "$t" >/dev/null; then "$t" "$d" || true; else echo "$t is not available"; continue; fi ;;
      sfdisk) sfdisk_script "$d" ;;
      *) echo "unknown tool"; continue ;;
    esac
    blockdev --rereadpt "$d" 2>/dev/null || true
    if command -v udevadm >/dev/null; then udevadm settle 2>/dev/null || true; fi
    lsblk -po NAME,SIZE,TYPE,FSTYPE,PARTTYPENAME "$d"
  done
}

checkpart() {
  local p=$1 what=$2 pk
  [ -b "$p" ] || die "$what $p is not a block device"
  [ "$(lsblk -dno TYPE "$p")" = part ] || die "$what $p is not a partition"
  if lsblk -nrpo MOUNTPOINT "$p" | grep -q .; then die "$what $p is mounted or in use, unmount it first"; fi
  pk=$(lsblk -no PKNAME "$p" | head -n1)
  [ -n "$pk" ] || die "cannot find the disk of $p"
  [ "/dev/$pk" != "$LIVEDISK" ] || die "$what $p is on the live iso medium"
}

MODE=${CLOUDOS_MODE:-}
if [ -z "$MODE" ]; then
  if [ -n "${CLOUDOS_ROOT:-}" ]; then MODE=manual
  elif [ -n "${CLOUDOS_DISK:-}" ]; then MODE=auto
  else
    echo "install mode:"
    echo "  auto    wipe a whole disk and install (simple)"
    echo "  manual  use your own partitions, the rest of the disk stays intact"
    ask MODE "mode (auto or manual)" auto
  fi
fi
case $MODE in auto|manual) ;; *) die "CLOUDOS_MODE must be auto or manual" ;; esac
say "install mode: $MODE"

FB=1
if [ "$MODE" = auto ]; then
  CLOUDOS_DISK=${CLOUDOS_DISK:-}
  if [ -z "$CLOUDOS_DISK" ]; then echo "disks:"; showdisks; fi
  ask CLOUDOS_DISK "disk to install to (it will be wiped)"
  DISK=$CLOUDOS_DISK
  [ -b "$DISK" ] || die "$DISK is not a block device"
  [ "$(lsblk -dno TYPE "$DISK")" = disk ] || die "$DISK is not a whole disk"
  [ "$DISK" != "$LIVEDISK" ] || die "$DISK is the medium the live iso booted from"
  if lsblk -nrpo MOUNTPOINT "$DISK" | grep -q .; then die "$DISK has mounted partitions, unmount them"; fi
  case $DISK in *[0-9]) P=${DISK}p ;; *) P=$DISK ;; esac
  BOOTDEV=${P}1
  ROOTPART=${P}2
else
  if [ -z "${CLOUDOS_ROOT:-}" ] || [ -z "${CLOUDOS_BOOT:-}" ]; then
    partition_disks
    echo "partitions:"
    showparts
  fi
  ask CLOUDOS_BOOT "boot partition (efi system partition on uefi, about 512M, fat32)"
  ask CLOUDOS_ROOT "root partition (it will be formatted)"
  BOOTDEV=$CLOUDOS_BOOT
  ROOTPART=$CLOUDOS_ROOT
  [ "$BOOTDEV" != "$ROOTPART" ] || die "boot and root must be different partitions"
  checkpart "$BOOTDEV" boot
  checkpart "$ROOTPART" root
  [ "$(blockdev --getsize64 "$ROOTPART")" -ge 4294967296 ] || die "root partition is smaller than 4 GiB"
  [ "$(blockdev --getsize64 "$BOOTDEV")" -ge 104857600 ] || die "boot partition is smaller than 100 MiB"
  DISK=/dev/$(lsblk -no PKNAME "$BOOTDEV" | head -n1)
  BT=$(blkid -s TYPE -o value "$BOOTDEV" 2>/dev/null || true)
  FB=${CLOUDOS_FORMAT_BOOT:-}
  if [ -z "$FB" ]; then
    if [ "$BT" = vfat ]; then
      if [ "${CLOUDOS_YES:-0}" = 1 ]; then FB=0; else ask FB "format the boot partition? no keeps the existing vfat and its files (yes/no)" no; fi
    else
      FB=1
    fi
  fi
  case $FB in 1|yes|y) FB=1 ;; 0|no|n) FB=0 ;; *) die "CLOUDOS_FORMAT_BOOT: 1 or 0" ;; esac
  if [ "$FB" = 0 ] && [ "$BT" != vfat ]; then die "$BOOTDEV is not vfat, it has to be formatted"; fi
fi

FS=${CLOUDOS_FS:-}
if [ -z "$FS" ]; then
  if command -v mkfs.btrfs >/dev/null; then ask FS "root filesystem (ext4 or btrfs)" ext4; else FS=ext4; fi
fi
case $FS in ext4) ;; btrfs) command -v mkfs.btrfs >/dev/null || die "this iso has no mkfs.btrfs, use ext4" ;; *) die "filesystem: ext4 or btrfs" ;; esac

LUKS=${CLOUDOS_LUKS:-}
if [ -z "$LUKS" ]; then
  if [ "${CLOUDOS_YES:-0}" = 1 ]; then LUKS=0; else ask LUKS "encrypt root with luks (yes/no)" no; fi
fi
case $LUKS in 1|yes|y) LUKS=1 ;; 0|no|n) LUKS=0 ;; *) die "CLOUDOS_LUKS: 1 or 0" ;; esac
if [ "$LUKS" = 1 ]; then
  for c in cryptsetup dracut; do command -v "$c" >/dev/null || die "luks needs the command $c"; done
  askpass CLOUDOS_LUKSPASS "disk encryption password"
fi

PROFILE=${CLOUDOS_PROFILE:-balanced}
case $PROFILE in
  balanced) PA= ;;
  secure) PA='mitigations=auto,nosmt lockdown=integrity init_on_free=1' ;;
  fast) PA='nowatchdog audit=0' ;;
  *) die "CLOUDOS_PROFILE: balanced, secure or fast" ;;
esac
EXTRA="$EXTRA $PA"
SB=${CLOUDOS_SECUREBOOT:-0}
case $SB in 0|1) ;; *) die "CLOUDOS_SECUREBOOT: 1 or 0" ;; esac
UKI=${CLOUDOS_UKI:-0}
case $UKI in 0|1) ;; *) die "CLOUDOS_UKI: 1 or 0" ;; esac
[ "$UKI" = 0 ] || [ "$SB" = 1 ] || die "CLOUDOS_UKI needs CLOUDOS_SECUREBOOT=1"
if [ "$SB" = 1 ]; then
  [ "$FW" = uefi ] || die "secure boot works only in uefi mode"
  for c in cloudos-secureboot sbsign sbverify cert-to-efi-sig-list sign-efi-sig-list b2sum openssl; do command -v "$c" >/dev/null || die "secure boot needs the command $c"; done
fi

ask CLOUDOS_HOST "hostname" cloudos
HOSTN=$CLOUDOS_HOST
printf '%s' "$HOSTN" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$' || die "invalid hostname"
ask CLOUDOS_USER "username"
USERN=$CLOUDOS_USER
printf '%s' "$USERN" | grep -Eq '^[a-z_][a-z0-9_-]{0,30}$' || die "invalid username"
case $USERN in root|cloudos) die "this name is reserved, pick another" ;; esac
askpass CLOUDOS_PASS "password for $USERN"
askpass CLOUDOS_ROOTPASS "root password"

if [ -z "${CLOUDOS_KEYMAP:-}" ] && [ "${CLOUDOS_YES:-0}" != 1 ]; then
  echo "keyboard layout:"
  echo "  us   english only (default)"
  echo "  ru   english and russian, english is the default, a key combination switches"
  echo "  or the name of any kbd keymap, for example de, fr, ua"
fi
askdef CLOUDOS_KEYMAP "layout" us
KEYMAP=$CLOUDOS_KEYMAP
case $KEYMAP in 1|en) KEYMAP=us ;; 2) KEYMAP=ru ;; esac
printf '%s' "$KEYMAP" | grep -Eq '^[A-Za-z0-9_.+-]{1,40}$' || die "invalid keymap name"
SWITCH=
KMAP=$KEYMAP
KFONT=
if [ "$KEYMAP" = ru ]; then
  if [ -z "${CLOUDOS_SWITCH:-}" ] && [ "${CLOUDOS_YES:-0}" != 1 ]; then
    echo "layout switch key:"
    echo "  alt_shift    left alt + shift (default)"
    echo "  ctrl_shift   ctrl + shift"
    echo "  caps         caps lock"
  fi
  askdef CLOUDOS_SWITCH "switch layout with" alt_shift
  SWITCH=$CLOUDOS_SWITCH
  case $SWITCH in 1|alt_shift|alt+shift) SWITCH=alt_shift ;; 2|ctrl_shift|ctrl+shift) SWITCH=ctrl_shift ;; 3|caps) SWITCH=caps ;; esac
  case $SWITCH in
    alt_shift) KMAP=ruwin_alt_sh-UTF-8 ;;
    ctrl_shift) KMAP=ruwin_ct_sh-UTF-8 ;;
    caps) KMAP=ruwin_cplk-UTF-8 ;;
    *) die "CLOUDOS_SWITCH: alt_shift, ctrl_shift or caps" ;;
  esac
fi
if [ "$KMAP" != us ]; then
  findmap "$KMAP" || die "keymap $KMAP is not available on this iso"
fi
if [ "$KEYMAP" = ru ]; then
  for f in cyr-sun16 LatArCyrHeb-16; do
    if findfont "$f"; then KFONT=$f; break; fi
  done
  [ -n "$KFONT" ] || echo "warning: no cyrillic console font on this iso, russian letters will not be shown on the console"
fi

askdef CLOUDOS_LOCALE "system language (locale)" en_US.UTF-8
LOC=$CLOUDOS_LOCALE
printf '%s' "$LOC" | grep -Eq '^([a-z]{2,3}_[A-Z]{2}\.UTF-8|C\.UTF-8)$' || die "invalid locale, use for example en_US.UTF-8 or ru_RU.UTF-8"

askdef CLOUDOS_TZ "time zone" UTC
TZN=$CLOUDOS_TZ
printf '%s' "$TZN" | grep -Eq '^[A-Za-z0-9_+/-]{1,64}$' || die "invalid time zone"
case $TZN in *..*|/*) die "invalid time zone" ;; esac
[ -f "/usr/share/zoneinfo/$TZN" ] || die "unknown time zone $TZN, see /usr/share/zoneinfo"

if [ "${CLOUDOS_YES:-0}" != 1 ]; then
  echo
  if [ "$MODE" = auto ]; then
    echo "disk $DISK will be wiped completely: $(lsblk -dno SIZE,MODEL "$DISK")"
    read -r -p "to confirm type the disk path ($DISK): " c
    [ "$c" = "$DISK" ] || die "not confirmed, the disk is untouched"
  else
    echo "root  $ROOTPART will be formatted as $FS: $(lsblk -dno SIZE "$ROOTPART")"
    if [ "$FB" = 1 ]; then echo "boot  $BOOTDEV will be formatted as vfat: $(lsblk -dno SIZE "$BOOTDEV")"; else echo "boot  $BOOTDEV is reused, existing files are kept"; fi
    echo "all other partitions are left untouched"
    read -r -p "to confirm type the root partition path ($ROOTPART): " c
    [ "$c" = "$ROOTPART" ] || die "not confirmed, nothing was touched"
  fi
fi

if [ "$MODE" = auto ]; then
  say "partitioning $DISK ($FW)"
  wipefs -a "$DISK" >/dev/null
  if [ "$FW" = uefi ]; then
    printf 'label: gpt\n,512M,U\n,,L\n' | sfdisk -q "$DISK"
  else
    printf 'label: dos\n,512M,c,*\n,,L\n' | sfdisk -q "$DISK"
  fi
  blockdev --rereadpt "$DISK" 2>/dev/null || true
  command -v udevadm >/dev/null && udevadm settle 2>/dev/null || true
  n=0
  until [ -b "$BOOTDEV" ] && [ -b "$ROOTPART" ]; do
    n=$((n + 1)); [ "$n" -lt 20 ] || die "partitions $BOOTDEV and $ROOTPART did not appear"
    sleep 0.5
  done
else
  wipefs -a "$ROOTPART" >/dev/null
  if [ "$FB" = 1 ]; then wipefs -a "$BOOTDEV" >/dev/null; fi
fi

say "filesystems"
if [ "$FB" = 1 ]; then mkfs.vfat -F32 -n CLOUDBOOT "$BOOTDEV" >/dev/null; fi
ROOTDEV=$ROOTPART
if [ "$LUKS" = 1 ]; then
  say "luks2 encryption (aes-xts, argon2id)"
  printf '%s' "$CLOUDOS_LUKSPASS" | cryptsetup luksFormat --type luks2 --cipher aes-xts-plain64 --key-size 512 --hash sha512 --pbkdf argon2id --batch-mode "$ROOTPART" -
  printf '%s' "$CLOUDOS_LUKSPASS" | cryptsetup open --type luks2 "$ROOTPART" cloudcrypt -
  LUKSOPEN=1
  ROOTDEV=/dev/mapper/cloudcrypt
fi
if [ "$FS" = ext4 ]; then
  mkfs.ext4 -q -F -L cloudos "$ROOTDEV"
  ROPTS=noatime,errors=remount-ro
else
  mkfs.btrfs -q -f -L cloudos "$ROOTDEV"
  ROPTS=noatime,compress=zstd:1
fi

say "mounting into $T"
mkdir -p "$T"
mount -o "$ROPTS" "$ROOTDEV" "$T"
MOUNTED=1

say "unpacking the system from the iso (main step)"
unsquashfs -f -d "$T" "$SQ"
mkdir -p "$T/proc" "$T/sys" "$T/dev" "$T/run" "$T/tmp" "$T/var/tmp" "$T/mnt" "$T/media"
chmod 1777 "$T/tmp" "$T/var/tmp"
[ -x "$T/sbin/init" ] || [ -x "$T/usr/sbin/init" ] || die "no init after unpacking, the image is damaged"
ls "$T/lib/modules" | grep -q cloudk || die "no cloudk kernel modules in the image, the image is damaged"

say "limine bootloader"
mount -o umask=0077,noatime "$BOOTDEV" "$T/boot"
install -m644 "$BS/vmlinuz" "$T/boot/vmlinuz"
mkdir -p "$T/boot/limine"
if [ -f "$T/boot/limine/limine.conf" ] && [ ! -e "$T/boot/limine/limine.conf.bak" ]; then cp -p "$T/boot/limine/limine.conf" "$T/boot/limine/limine.conf.bak"; fi
PU=$(blkid -s PARTUUID -o value "$ROOTPART")
RU=$(blkid -s UUID -o value "$ROOTDEV")
LU=
if [ "$LUKS" = 1 ]; then LU=$(blkid -s UUID -o value "$ROOTPART"); [ -n "$LU" ] || die "cannot get the luks uuid"; ROOTARG="rd.luks.uuid=$LU root=UUID=$RU"; else ROOTARG="root=PARTUUID=$PU"; fi
BU=$(blkid -s UUID -o value "$BOOTDEV")
[ -n "$PU" ] && [ -n "$RU" ] && [ -n "$BU" ] || die "cannot get partition uuids"
CMD="$ROOTARG rootfstype=$FS rw quiet $HARDEN"
VER=$(sed -n 's/^VERSION_ID=\(.*\)/\1/p' "$T/etc/os-release" | tr -d '"')
cat > "$T/boot/limine/limine.conf" <<EOC
timeout: 3

/CloudOS ${VER}
    protocol: linux
    path: boot():/vmlinuz
    cmdline: $CMD $EXTRA

/CloudOS ${VER} (verbose)
    protocol: linux
    path: boot():/vmlinuz
    cmdline: $ROOTARG rootfstype=$FS rw $HARDEN $EXTRA
EOC
if [ "$LUKS" = 1 ]; then
  sed -i 's|^    path: boot():/vmlinuz$|&\n    module_path: boot():/initramfs.img|' "$T/boot/limine/limine.conf"
fi
if [ "$FW" = uefi ]; then
  if [ "$FB" = 0 ] && [ -f "$T/boot/EFI/BOOT/BOOTX64.EFI" ] && [ ! -e "$T/boot/EFI/BOOT/BOOTX64.EFI.bak" ]; then
    cp -p "$T/boot/EFI/BOOT/BOOTX64.EFI" "$T/boot/EFI/BOOT/BOOTX64.EFI.bak"
  fi
  install -D -m644 "$LS/BOOTX64.EFI" "$T/boot/EFI/BOOT/BOOTX64.EFI"
  install -D -m644 "$LS/BOOTIA32.EFI" "$T/boot/EFI/BOOT/BOOTIA32.EFI"
else
  install -m644 "$LS/limine-bios.sys" "$T/boot/limine/limine-bios.sys"
  limine bios-install "$DISK" >/dev/null || die "limine bios-install failed on $DISK, for gpt create a bios boot partition"
fi

say "fstab and hostname"
cat > "$T/etc/fstab" <<EOF
UUID=$RU / $FS $ROPTS 0 $([ "$FS" = ext4 ] && echo 1 || echo 0)
UUID=$BU /boot vfat umask=0077,noatime 0 2
tmpfs /tmp tmpfs nosuid,nodev,mode=1777 0 0
EOF
printf 'hostname="%s"\n' "$HOSTN" > "$T/etc/conf.d/hostname"
printf '127.0.0.1 localhost %s\n::1 localhost\n' "$HOSTN" > "$T/etc/hosts"
if grep -q '^#\?rc_parallel=' "$T/etc/rc.conf"; then
  sed -i 's/^#\?rc_parallel=.*/rc_parallel="YES"/' "$T/etc/rc.conf"
else
  printf 'rc_parallel="YES"\n' >> "$T/etc/rc.conf"
fi

say "removing live traces and creating users"
mount --rbind /dev "$T/dev"; mount --make-rslave "$T/dev"
mount -t proc proc "$T/proc"
mount --rbind /sys "$T/sys"; mount --make-rslave "$T/sys"
mount -t tmpfs tmpfs "$T/run"
cat /etc/resolv.conf > "$T/etc/resolv.conf" 2>/dev/null || echo 'nameserver 1.1.1.1' > "$T/etc/resolv.conf"
inroot() { chroot "$T" /usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM="${TERM:-linux}" LANG=C.UTF-8 "$@"; }

if [ "$LUKS" = 1 ]; then
  say "initramfs with luks (dracut)"
  KREL=$(ls "$T/lib/modules" | head -n1)
  [ -n "$KREL" ] || die "no kernel modules in $T/lib/modules"
  inroot dracut --force --no-hostonly --kver "$KREL" --add crypt --compress zstd /boot/initramfs.img
  [ -s "$T/boot/initramfs.img" ] || die "initramfs was not created"
fi

if [ "$SB" = 1 ]; then
  say "secure boot: keys, kernel hashes, limine signature"
  export CLOUDOS_SBDIR="$T/etc/cloudos/secureboot" CLOUDOS_BOOT="$T/boot" CLOUDOS_LIMINE_EFI="$LS/BOOTX64.EFI"
  cloudos-secureboot init
  if [ "$UKI" = 1 ]; then
    say "unified kernel image"
    CLOUDOS_OSREL="$T/etc/os-release" cloudos-uki build
  fi
  cloudos-secureboot sign
fi

rm -f "$T/etc/init.d/cloudos-smoke" "$T/etc/runlevels/default/cloudos-smoke" "$T/etc/conf.d/agetty.tty1" \
  "$T/etc/ssh/sshd_config.d/05-cloudos-live.conf" "$T/etc/machine-id" "$T/var/lib/dbus/machine-id"
rm -f "$T"/etc/ssh/ssh_host_*
if inroot id cloudos >/dev/null 2>&1; then inroot userdel -r cloudos >/dev/null 2>&1 || inroot userdel cloudos; fi
for g in wheel users video audio netdev; do inroot getent group "$g" >/dev/null || inroot groupadd "$g"; done
if inroot getent passwd "$USERN" >/dev/null 2>&1; then
  say "user $USERN is already in the image: $(grep "^$USERN:" "$T/etc/passwd" | head -n1)"
  inroot usermod -s /bin/bash -aG wheel,users,video,audio,netdev "$USERN"
  UH=$(inroot getent passwd "$USERN" | cut -d: -f6)
  [ -d "$T$UH" ] || { inroot install -d -m 0700 -o "$USERN" -g "$(inroot id -gn "$USERN")" "$UH"; cp -a "$T"/etc/skel/. "$T$UH"/ 2>/dev/null || true; inroot chown -R "$USERN:$(inroot id -gn "$USERN")" "$UH"; }
else
  inroot useradd -m -G wheel,users,video,audio,netdev -s /bin/bash "$USERN"
fi
printf '%s:%s\n' "$USERN" "$CLOUDOS_PASS" | inroot chpasswd
printf 'root:%s\n' "$CLOUDOS_ROOTPASS" | inroot chpasswd
say "keyboard, language, time zone"
install -d "$T/etc/conf.d" "$T/etc/runlevels/boot" "$T/etc/profile.d"
printf 'keymap="%s"\n' "$KMAP" > "$T/etc/conf.d/keymaps"
[ -e "$T/etc/init.d/keymaps" ] && ln -sf /etc/init.d/keymaps "$T/etc/runlevels/boot/keymaps" || echo "warning: no keymaps init script in the system, the console keymap will not be loaded at boot"
if [ -n "$KFONT" ]; then
  printf 'consolefont="%s"\n' "$KFONT" > "$T/etc/conf.d/consolefont"
  [ -e "$T/etc/init.d/consolefont" ] && ln -sf /etc/init.d/consolefont "$T/etc/runlevels/boot/consolefont" || echo "warning: no consolefont init script in the system"
fi
if [ "$LOC" != C.UTF-8 ]; then
  inroot localedef -i "${LOC%%.*}" -f UTF-8 "$LOC" >/dev/null 2>&1 || { echo "warning: locale $LOC is not available, using C.UTF-8"; LOC=C.UTF-8; }
fi
printf 'LANG=%s\n' "$LOC" > "$T/etc/locale.conf"
printf 'export LANG=%s\n' "$LOC" > "$T/etc/profile.d/cloudos-locale.sh"
chmod 644 "$T/etc/profile.d/cloudos-locale.sh"
ln -sf "/usr/share/zoneinfo/$TZN" "$T/etc/localtime"
printf '%s\n' "$TZN" > "$T/etc/timezone"
[ "$(readlink "$T/etc/localtime")" = "/usr/share/zoneinfo/$TZN" ] && [ -f "$T/usr/share/zoneinfo/$TZN" ] || die "time zone $TZN was not set"
grep -qx "keymap=\"$KMAP\"" "$T/etc/conf.d/keymaps" || die "keymap was not written"
printf 'permit persist :wheel\n' > "$T/etc/doas.conf"
chmod 600 "$T/etc/doas.conf"
cat > "$T/etc/motd" <<EOM

CloudOS ${VER}. login: ${USERN}, root rights: doas -s
firewall is on: cloudos-firewall status
packages: cloudpkg search name, cloudpkg install name
https://wh1laye.github.io/cloudos-repo/

EOM
inroot passwd -S root | grep -q ' P ' || die "root password was not set"
inroot passwd -S "$USERN" | grep -q ' P ' || die "password for $USERN was not set"
grep -q "^$USERN:" "$T/etc/passwd" || die "user $USERN was not created"
! grep -q '^cloudos:' "$T/etc/passwd" || die "live user was not removed"
[ -s "$T/boot/limine/limine.conf" ] && [ -s "$T/boot/vmlinuz" ] || die "bootloader was not written"

say "done: cloudos installed (root $ROOTPART, boot $BOOTDEV, $FW, $FS$([ "$LUKS" = 1 ] && echo ', luks2'))"
say "kernel: $(ls "$T/lib/modules" | grep cloudk | head -n1)"
say "keyboard: $KEYMAP${SWITCH:+ (switch: $SWITCH)}, language: $LOC, time zone: $TZN"
if [ "$MODE" = manual ] && [ "$FW" = uefi ] && [ "$FB" = 0 ]; then
  echo "the previous fallback loader was saved as EFI/BOOT/BOOTX64.EFI.bak on $BOOTDEV, add other systems to the limine menu if needed"
fi
if [ "${CLOUDOS_YES:-0}" != 1 ]; then
  echo "run reboot and remove the install medium"
  if [ "$SB" = 1 ]; then
    echo "secure boot: save a copy of /etc/cloudos/secureboot, enter uefi setup, clear the secure boot keys (setup mode),"
    echo "boot cloudos, run doas cloudos-secureboot enroll, then enable secure boot in the firmware"
  fi
fi
